		widget = { # 2.1.23 Erklaerpanel RECHTS vom Seitenfenster (Maxim 24-10, Bild 677/679): Kind von mbq_gr_side (nur sichtbar mit erweiterter Ansicht), links am rechten Rand des Seitenfensters; waechst mit dem Inhalt (resizeparent wie mbq_gr_side), der Text kann den Hintergrund nicht verlassen
			name = "mbq_expl_panel"
			visible = "[GetGlobalVariable( 'mbq_expl_on' ).IsSet]" # 2.1.34: Globalvariable im Spielstand (vorher GUI-Variable mbq_expl, nach jedem Start zu); in neuen Spielen aus (2.1.48), nur der Klick setzt sie (mbq_expl_toggle)
			parentanchor = top|right
			widgetanchor = top|left # V game_rules.gui:530-531, wie mbq_gr_side am Hauptfenster
