						trigger_when = "[And( CourtPositionType.HasAutomationShowEvent( GetPlayer ), And( GetGlobalVariable( 'mbq_cp_lvl_3' ).IsSet, And( Not( GetVariableSystem.Exists( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_1' ) ) ), IsValidCommand( CourtPositionType.ToggleAutomationCmd ) ) ) )]"
						on_start = "[GetVariableSystem.Set( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_1' ), 'yes' )]"
						on_start = "[PostCommand( CourtPositionType.ToggleAutomationCmd )]"
					}
					state = {
						name = mbq_cp_s3_from2
						trigger_when = "[And( CourtPositionType.HasAutomationAssignBest( GetPlayer ), And( GetGlobalVariable( 'mbq_cp_lvl_3' ).IsSet, And( Not( GetVariableSystem.Exists( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_2' ) ) ), IsValidCommand( CourtPositionType.ToggleAutomationCmd ) ) ) )]"
						on_start = "[GetVariableSystem.Set( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_2' ), 'yes' )]"
						on_start = "[PostCommand( CourtPositionType.ToggleAutomationCmd )]"
					}
					state = {
						name = _hide
						duration = 0.1
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t0_1' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t0_2' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t0_3' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t1_0' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t1_2' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t1_3' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t2_0' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t2_1' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t2_3' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_0' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_1' ) )]"
						on_start = "[GetVariableSystem.Clear( Concatenate( Concatenate( 'mbq_cp_v_', CourtPositionType.GetKey ), '_t3_2' ) )]"
