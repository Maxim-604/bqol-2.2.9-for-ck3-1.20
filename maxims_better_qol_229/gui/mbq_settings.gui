								maximumsize = { 400 840 } # 2.1.23: Panel waechst mit dem Inhalt (resizeparent), Hoehe = 18 + Scrollbereich + 30 (Sprachen: gerechnet 448 bis 643 Text, dev/rechnung_expl_hoehe_2123.py); Scroll erst ueber 840 (Bildschirm 1440 hoch bei 130 Prozent = 1108 Einheiten, Oberkante 104)
								scrollbarpolicy_horizontal = always_off
								scrollwidget = {
									flowcontainer = {
