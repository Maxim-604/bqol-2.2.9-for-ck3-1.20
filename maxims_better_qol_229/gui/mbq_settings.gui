# Better Quality of Life 2.0.0: Kategorien Allgemein / Gefaengnis und Loesegeld / Vasallen / Grafschaften (Maxim 14-10, build_loesegeld.py Abschnitt 5).
# Better Quality of Life 1.0.3 (0.3.23 base; 1.0.3: priorities below the scroll area, open lists float over the window): ONE settings window that grows with its content, can be moved, and scrolls above a height limit.
# Outer vertical flowcontainer (ignoreinvisible, resizeparent: interaction_menu_window.gui:34-36, :53-58): margin 18, header 56,
# scroll area, bottom 30 (10 + Window_Margins 20, shared/windows.gui:122-128). The scroll area grows with its content up to
# maximumsize and then shows a scrollbar: autoresizescrollarea + maximumsize as lists.gui:810-833, resizeparent + maximumsize as
# window_title.gui:697-700. Limit (1.0.3): window at most 18 + 56 + 394 + 169 + 30 = 667; from the default place (top edge 248 above the
# screen middle, 292 on 1080p) the list of priority 4 then ends 8 above the bottom of a 1080p screen. Rows have fixed heights, the pixels of the 0.3.5 layout
# (dev/vorschau_fenster/v6_abstaende_035). 1.0.3: the open priority list floats over the window (see float_list).
widget = {
	name = "mbq_settings"
	size = { 100% 100% }
	layer = top # Seitenfenster ueber dem Outliner (hud_outliner.gui:7 windows_layer, hud.gui:935 top)

	widget = { # 24-10-2026 Entscheidung "Mods von Maxim" oeffnet das Fenster (Muster Better UI mbui_hud_pos.gui:446-459); nur Zustand, nichts sichtbar
		name = "mbq_open_req_host"
		size = { 1 1 }
		state = {
			name = mbq_open_req
			trigger_when = "[And( GetPlayer.IsValid, GetGlobalVariable( 'mbq_open_req' ).IsSet )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_dd_open' )]"
			on_start = "[GetVariableSystem.Set( 'mbq_settings_open', 'yes' )]"
			on_start = "[CloseGameView( 'decisions' )]"
			on_start = "[GetScriptedGui( 'mbq_open_clear' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
		}
	}

	window = {
		name = "mbq_settings_window"
		visible = "[And( GetVariableSystem.Exists( 'mbq_settings_open' ), And( GetPlayer.IsValid, IsDefaultGUIMode ) )]"
		parentanchor = top|hcenter # BQoL 2.0 Spieltest 2: oben mittig
		widgetanchor = top|hcenter # top edge stays, only the bottom grows (frontend_bookmarks.gui:3742-3744)
		position = { 0 104 } # 2.1.25 (Maxim 24-10): wieder mittig wie vor 2.1.23; das Fenster bleibt verschiebbar (Window_Movable), bei offenem Seitenfenster und Erklaerpanel schiebt der Spieler es selbst nach links. Hoehe der Hof-Reiter (V window_court.gui:30, windows.gui:122-128)
		using = Window_Background
		using = Window_Decoration
		using = Window_Movable
		layer = top # Fenster selbst sonst windows_layer (preload/defaults.gui:227), wie der Outliner
		allow_outside = yes # 1.0.3: lists of priority 2 to 4 reach below the window; child outside its parent stays clickable as hud.gui:3739 / :3791-3799 (proven in Marry Off All Children 0.3.1)

		state = { # BQoL 2.0 Spieltest: Vorschau beim Oeffnen neu rechnen (Muster BUI window_court.gui:20-25 on_start Execute), kein Takt
			name = _show
			on_start = "[GetScriptedGui( 'mbq_open_preview' ).Execute( GuiScope.SetRoot( GetPlayer.MakeScope ).End )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc1' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc2' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc3' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc4' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc5' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc6' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_gc7' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_pr1' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_pr2' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_pr3' )]"
			on_start = "[GetVariableSystem.Clear( 'mbq_hov_pr4' )]"
		}


		widget = { # BQoL 2.0 Seitenfenster erweiterte Ansicht (build_grafschaften.py, Rechnung dev/grafschaften/rechnung.md)
			name = "mbq_gr_side"
			visible = "[And( GetVariableSystem.HasValue( 'mbq_set_open', 'county' ), GetGlobalVariable( 'mbq_gr_adv_on' ).IsSet )]" # 2.1.32: Globalvariable im Spielstand (vorher GUI-Variable mbq_gr_adv, nach jedem Start ungehakt)
			parentanchor = top|right
			widgetanchor = top|left # V game_rules.gui:530-531
			position = { 0 0 }
			alwaystransparent = no # V frontend_load.gui:47
			using = Window_Background_Subwindow # 2.1.24 Vorlage WK:647-650 (V shared/windows.gui:283-312)

			flowcontainer = {
				direction = vertical
				ignoreinvisible = yes
				resizeparent = yes
				spacing = 0

				widget = { size = { 560 18 } }
			scrollarea = { # Seitenfenster: Filter, Prioritaeten, Grenzen
				autoresizescrollarea = yes # lists.gui:821
				maximumsize = { 540 862 } # Hauptfenster 643 wie Allgemein (mbq_settings.gui:57), Seitenfenster siehe GR_PANEL_MAXH
				scrollbarpolicy_horizontal = always_off
				scrollwidget = {
					flowcontainer = {
						direction = vertical
						ignoreinvisible = yes
						spacing = 0
			widget = { size = { 528 10 } }
			widget = { # row 23
				size = { 528 23 }
				widget = { # 2.1.24 Leiste hinter der Ueberschrift (Vorlage widget_permission_header, V window_knights.gui:1165-1203), nur Optik
					position = { 40 0 }
					size = { 480 23 }
					alwaystransparent = yes
					using = Mbqw_Background_Header
				}
				text_single = {
					visible = "[Not( Not( GetScriptedGui( 'mbq_gr_slots_ok' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) ) )]"
					position = { 40 0 }
					size = { 480 23 }
					autoresize = no
					text = "MBQ_GR_WHO"
					align = left|nobaseline
					using = tooltip_es
					tooltip = "MBQ_GR_TT_WHO"
				}
				text_single = {
					visible = "[Not( GetScriptedGui( 'mbq_gr_slots_ok' ).IsShown( GuiScope.SetRoot( GetPlayer.MakeScope ).End ) )]"
					position = { 40 0 }
					size = { 480 23 }
					autoresize = no
					default_format = "#N" # Standardschrift wie V hud_outliner.gui:169-174 (Spieltest 2)
					text = "MBQ_GR_WHO"
					align = left|nobaseline
					using = tooltip_es
					tooltip = "MBQ_GR_TT_WHO_RED"
				}
			}
